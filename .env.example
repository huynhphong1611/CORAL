# Copy to .env at the repo root. Never commit .env.
# Values below are development defaults and match compose.yaml.

# --- server (apps/server) ---
CORAL_SERVER_HOST=0.0.0.0
CORAL_SERVER_PORT=3000
CORAL_LOG_LEVEL=info
# Persistent data (project git repos, uploads) — used from Phase 1
CORAL_DATA_DIR=./data

# --- agent (apps/agent) ---
CORAL_SERVER_URL=http://localhost:3000
# Interval of the server reachability probe (ms)
CORAL_AGENT_POLL_MS=15000

# --- infrastructure (compose.yaml; consumed by the server from Phase 1) ---
POSTGRES_USER=coral
POSTGRES_PASSWORD=coral
POSTGRES_DB=coral
POSTGRES_PORT=5432
DATABASE_URL=postgres://coral:coral@localhost:5432/coral

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coral-artifacts
S3_ACCESS_KEY_ID=coral
S3_SECRET_ACCESS_KEY=coral-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- dev-only secrets for test cases before Phase 5 (SPEC D19) ---
# CORAL_SECRET_TEST_USER=
# CORAL_SECRET_TEST_PASSWORD=
