# Copy to .env at the repo root. Never commit .env.
# Values below are development defaults and match compose.yaml.

# --- server (apps/server) ---
CORAL_SERVER_HOST=0.0.0.0
CORAL_SERVER_PORT=3000
CORAL_LOG_LEVEL=info
# Persistent data (project git repos, uploads)
CORAL_DATA_DIR=./data
# Largest accepted build upload (MB); bigger uploads get 413
CORAL_MAX_BUILD_MB=500
# JWT signing key (≥ 32 chars). A development default is used when unset; required in production.
# CORAL_JWT_SECRET=
# Seeded operator account for `pnpm --filter @coral/server db:seed`
# CORAL_SEED_EMAIL=huynh@example.com
# CORAL_SEED_PASSWORD=
# Timeouts (ms)
CORAL_HEARTBEAT_MS=15000
CORAL_QUEUE_TIMEOUT_MS=600000
CORAL_RUN_TIMEOUT_MS=1800000

# --- agent (apps/agent) ---
CORAL_SERVER_URL=http://localhost:3000
# Interval of the server reachability probe (ms)
CORAL_AGENT_POLL_MS=15000
# Token returned once by POST /agents
# CORAL_AGENT_TOKEN=
# adb binary, optional pre-downloaded u2.jar, cache directory (default ~/.cache/coral)
CORAL_ADB=adb
# CORAL_U2_JAR=
# CORAL_CACHE_DIR=

# --- infrastructure (compose.yaml; consumed by the server) ---
POSTGRES_USER=coral
POSTGRES_PASSWORD=coral
POSTGRES_DB=coral
POSTGRES_PORT=5432
DATABASE_URL=postgres://coral:coral@localhost:5432/coral

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coral-artifacts
S3_ACCESS_KEY_ID=coral
S3_SECRET_ACCESS_KEY=coral-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- dev-only secrets for test cases before Phase 5 (SPEC D19) ---
# CORAL_SECRET_TEST_USER=
# CORAL_SECRET_TEST_PASSWORD=
